<script>

/* ================= SCROLL MENU ================= */

function scrollKe(id){

    document.getElementById(id)
    .scrollIntoView({
        behavior:"smooth"
    });

}


/* ================= FOTO FULLSCREEN ================= */

function lihatFoto(src){

    document.getElementById("modal")
    .style.display="flex";

    document.getElementById("fotoBesar")
    .src=src;

}


function tutupFoto(){

    document.getElementById("modal")
    .style.display="none";

}


/* KLIK AREA GELAP UNTUK MENUTUP */

document.getElementById("modal")
.addEventListener("click",function(e){

    if(e.target===this){

        tutupFoto();

    }

});

</script>

