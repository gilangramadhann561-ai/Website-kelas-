<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SMK Gusti Wijaya | X TKJ¹</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#eef2f7;
    color:#172033;
}

/* ================= HEADER ================= */

.hero{
    min-height:70vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:white;
    padding:30px;

    background:
    linear-gradient(rgba(0,0,0,.65),rgba(0,0,0,.65)),
    url("background.jpg");

    background-size:cover;
    background-position:center;
}

.hero-content{
    animation:masuk 1.2s ease;
}

.logo{
    width:110px;
    height:110px;
    object-fit:cover;
    border-radius:50%;
    border:4px solid white;
    margin-bottom:20px;
}

.hero h1{
    font-size:42px;
    margin-bottom:10px;
}

.hero h2{
    font-size:25px;
    color:#60a5fa;
}

.hero p{
    margin-top:15px;
    font-size:17px;
}

/* ================= NAVBAR ================= */

nav{
    position:sticky;
    top:0;
    z-index:1000;

    display:flex;
    justify-content:center;
    flex-wrap:wrap;

    background:rgba(15,23,42,.96);
    backdrop-filter:blur(10px);
}

nav button{
    border:none;
    background:none;
    color:white;
    padding:16px 18px;
    cursor:pointer;
    font-size:14px;
    transition:.3s;
}

nav button:hover{
    background:#2563eb;
}

/* ================= SECTION ================= */

section{
    max-width:1100px;
    margin:auto;
    padding:70px 20px;
}

.judul{
    text-align:center;
    margin-bottom:35px;
}

.judul h2{
    font-size:30px;
    color:#1d4ed8;
}

.judul p{
    margin-top:8px;
    color:#64748b;
}

/* ================= CARD ================= */

.cards{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(230px,1fr));

    gap:20px;
}

.card{
    background:white;
    padding:25px;
    border-radius:20px;
    text-align:center;

    box-shadow:0 8px 25px rgba(0,0,0,.08);

    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 15px 35px rgba(0,0,0,.15);
}

.icon{
    font-size:40px;
    margin-bottom:15px;
}

.card h3{
    color:#2563eb;
    margin-bottom:10px;
}

.card p{
    color:#64748b;
    line-height:1.6;
}

/* ================= STATISTIK ================= */

.statistik{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(180px,1fr));

    gap:20px;
}

.stat{
    background:linear-gradient(135deg,#1d4ed8,#2563eb);
    color:white;
    padding:30px;
    border-radius:20px;
    text-align:center;

    box-shadow:0 10px 25px rgba(37,99,235,.25);
}

.stat .angka{
    font-size:42px;
    font-weight:bold;
}

.stat p{
    margin-top:8px;
}

/* ================= PENGURUS ================= */

.pengurus{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));

    gap:20px;
}

.orang{
    background:white;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 8px 20px rgba(0,0,0,.08);
    cursor:pointer;
    transition:.3s;
}

.orang:hover{
    transform:scale(1.03);
}

.orang img{
    width:100%;
    height:230px;
    object-fit:cover;
}

.orang-info{
    padding:18px;
    text-align:center;
}

.orang-info h3{
    color:#2563eb;
}

.orang-info p{
    color:#64748b;
    margin-top:5px;
}

/* ================= GALERI ================= */

.galeri{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(200px,1fr));

    gap:15px;
}

.galeri img{
    width:100%;
    height:220px;
    object-fit:cover;
    border-radius:18px;
    cursor:pointer;
    transition:.3s;
}

.galeri img:hover{
    transform:scale(1.04);
}

/* ================= ALAMAT ================= */

.alamat{
    background:white;
    border-radius:20px;
    padding:30px;
    line-height:2;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
}

.alamat h3{
    color:#2563eb;
}

/* ================= TOMBOL ================= */

.btn{
    display:inline-block;
    margin-top:20px;
    padding:13px 22px;

    background:#2563eb;
    color:white;

    border-radius:30px;
    text-decoration:none;

    transition:.3s;
}

.btn:hover{
    background:#1d4ed8;
    transform:translateY(-3px);
}

/* ================= MODAL FOTO ================= */

.modal{
    display:none;
    position:fixed;
    z-index:9999;

    left:0;
    top:0;

    width:100%;
    height:100%;

    background:rgba(0,0,0,.9);

    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal img{
    max-width:95%;
    max-height:85%;
    border-radius:15px;
}

.close{
    position:absolute;
    top:20px;
    right:30px;

    color:white;
    font-size:40px;

    cursor:pointer;
}

/* ================= FOOTER ================= */

footer{
    background:#0f172a;
    color:white;
    text-align:center;
    padding:35px 20px;
}

footer p{
    margin:7px;
}

/* ================= ANIMASI ================= */

@keyframes masuk{
    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* ================= MOBILE ================= */

@media(max-width:600px){

    .hero{
        min-height:60vh;
    }

    .hero h1{
        font-size:28px;
    }

    .hero h2{
        font-size:20px;
    }

    nav button{
        padding:12px 9px;
        font-size:12px;
    }

    section{
        padding:50px 15px;
    }

}
</style>
</head>

